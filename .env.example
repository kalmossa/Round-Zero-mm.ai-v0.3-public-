# ============================================================
# MM.AI - Variables d'environnement
# Copie ce fichier en ".env" et remplis les valeurs.
# Ne commit JAMAIS le .env (il est dans .gitignore).
# ============================================================

# ─── LOCAL (pgAdmin4) ───────────────────────────────────────
# Utilise si USE_SUPABASE=False
DB_NAME=mmai_db
DB_USER=postgres
DB_PASSWORD=ton_mot_de_passe_local
DB_HOST=localhost
DB_PORT=5432

# ─── SUPABASE (Production) ─────────────────────────────────
# Recupere ces infos dans :
#   Supabase Dashboard > ton projet > Settings > Database
#   Section "Connection parameters" (pas "Connection string")
#
# Host     : champ "Host"     (ex: db.xxxxxxxxxxxx.supabase.co)
# Password : champ "Password" (le mot de passe que tu as choisi)
SUPABASE_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_PASSWORD=ton_mot_de_passe_supabase
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PORT=5432

# ─── SWITCH ────────────────────────────────────────────────
# True  → utilise Supabase (prod)
# False → utilise PostgreSQL local (dev)
USE_SUPABASE=False

# ─── AUTH (Slice 1A) ───────────────────────────────────────
# JWT secret pour signer les tokens (CHANGE en prod, n'importe quelle chaine longue
# aleatoire fait l'affaire — ex: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change_me_in_production_use_a_long_random_string

# URL de base de l'app (utilisee pour les liens dans les emails de verification)
# Local dev : http://localhost:5000
# Prod      : your own domain
APP_BASE_URL=http://localhost:5000

# ─── ADMIN ─────────────────────────────────────────────────
# Liste des emails qui ont acces au panel admin (/admin.html + /api/admin/*).
# Separes par virgule. Le compte connecte avec un de ces emails devient admin.
# Rien a changer en base : la barriere est 100% serveur-side (decorateur).
# Laisse vide = aucun admin.
ADMIN_EMAILS=you@example.com

# ─── EMAIL (Resend) ────────────────────────────────────────
# Inscription gratuite sur resend.com (3000 emails/mois free)
# Si vide ou absent, les emails de verif sont juste imprimes dans le terminal
# (mode dev console, le code marche pareil).
RESEND_API_KEY=
# Adresse expediteur. Pour demarrer sans config DNS : onboarding@resend.dev
# Une fois ton domaine verifie sur Resend : noreply@ton-domaine.com
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=MM.AI

# ─── IA / LLM (analyses de combat redigees) ────────────────────────────────
# Sert l'endpoint /api/matchmaking/analysis. Si vide -> analyse "de secours"
# sans IA (le site marche pareil).
#
# Choisis UN fournisseur :
#   gemini     -> GRATUIT, sans carte bancaire   (recommande)  aistudio.google.com/apikey
#   openrouter -> 1 cle = tous les modeles                      openrouter.ai/keys
#   groq       -> gratuit, tres rapide                          console.groq.com/keys
LLM_PROVIDER=gemini

# Colle ici la cle du fournisseur choisi (laisse les autres vides) :
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# (Optionnel) forcer un modele precis. Sinon un bon modele gratuit est choisi.
# LLM_MODEL=gemini-2.5-flash
